      "claim": {
        "kind": "token+url",
        "field": "claimToken",
        "urlField": "claimUrl",
        "pattern": null,
        "warning": "The claim token is returned exactly once and grants ownership. Never forward it. The claimUrl must be copied byte for byte."
      },
      "health": {
        "state": "unknown",
        "checkedAt": null,
        "failures": 0
      },
      "verification": {
        "status": "live-tested",
        "resourcesByteExact": true,
        "verifiedAt": "2026-09-10",
        "note": "live-tested: the create/finalize flow works (upload.versionId, upload.finalizeUrl, siteUrl) and JS/CSS/font resources are served byte-identical. here.now injects Open Graph meta tags into the served index.html (416 bytes became 798), so HTML bytes are not hash-verified."
      }
