{
  "registryVersion": 1,
  "capabilitySchema": 1,
  "updatedAt": "2026-09-10",
  "notes": "Builtin provider registry for teacher-publish. Shipped and signed with the app. adapter/endpoint/protocol/allowedHosts/capabilities are authoritative; a remote status overlay may only change enabled, priority, health, lastValidated and notes. Capability values were transcribed from docs/provider-protocols.md; 'null' means the service does not document a limit and no limit is enforced client side.",
  "providers": [
    {
      "id": "ship-page",
      "label": "ship.page",
      "adapter": "ship-page",
      "endpoint": "https://ship.page/deploy",
      "protocol": "alpha2-json-file-map",
      "protocolNotes": "Documented reference is a JSON file map, but the live service accepts application/zip. The zip form is used because it preserves bytes exactly, which remote SHA-256 verification requires. UNVERIFIED in docs; live-tested.",
      "transport": "zip-post",
      "allowedHosts": [
        "ship.page",
        "*.shipped.page",
        "*.shipped.run"
      ],
      "modes": [
        "quick-share"
      ],
      "priority": 100,
      "cnPriority": 100,
      "enabled": true,
      "persistent": false,
      "availability": "live",
      "capabilities": {
        "anonymous": true,
        "maxFiles": 100,
        "maxFileBytes": null,
        "maxTotalBytes": 26214400,
        "maxTotalBytesSource": "25 MiB zip",
        "supportedExtensions": null,
        "denyExtensions": [],
        "extensionPolicy": "any",
        "supportsModelFiles": true,
        "claimable": true,
        "htmlExact": true,
        "ttl": {
          "defaultSeconds": 2592000,
          "optionsSeconds": null,
          "source": "30 days anonymous lifetime"
        },
        "singlePageOnly": false
      },
      "claim": {
        "kind": "claim_token",
        "field": "claim_token",
        "pattern": "^spc_[a-z0-9]{24}$",
        "warning": "The claim token is shown exactly once and grants ownership. Never forward it."
      },
      "health": {
        "state": "unknown",
        "checkedAt": null,
        "failures": 0
      },
      "verification": {
        "status": "live-tested",
        "resourcesByteExact": true,
        "verifiedAt": "2026-09-10",
        "note": "live-tested: a 63-file artifact was served byte-identical for every file, HTML included."
      }
    },
    {
      "id": "shipstatic",
      "label": "ShipStatic",
      "adapter": "shipstatic",
      "endpoint": "https://api.shipstatic.com/deployments",
      "protocol": "multipart-files-checksums",
      "protocolNotes": "Live-verified: multipart/form-data with files[] (one part per file, filename carries the relative path) plus checksums (JSON array of MD5, same order) returns 201 {deployment,url,files,size,status,expires,claim}. Optional Idempotency-Key replays the original 201 for 24 h with Idempotency-Replay: true. Zero-byte file parts are dropped by the service parser and then rejected by the checksum count check.",
      "transport": "multipart",
      "allowedHosts": [
        "api.shipstatic.com",
        "*.shipstatic.com"
      ],
      "modes": [
        "quick-share"
      ],
      "priority": 90,
      "cnPriority": 90,
      "enabled": true,
      "persistent": false,
      "availability": "live",
      "capabilities": {
        "anonymous": true,
        "maxFiles": 500,
        "maxFileBytes": 20971520,
        "maxTotalBytes": 52428800,
        "maxTotalBytesSource": "50 MiB",
        "supportedExtensions": null,
        "denyExtensions": [],
        "extensionPolicy": "blocklist",
        "supportsModelFiles": true,
        "claimable": true,
        "htmlExact": false,
        "idempotent": true,
        "ttl": {
          "defaultSeconds": 259200,
          "optionsSeconds": null,
          "source": "3 days anonymous lifetime"
        },
        "singlePageOnly": false
      },
      "claim": {
        "kind": "claim_url",
        "field": "claim",
        "pattern": null,
        "warning": "Anyone holding the claim URL can take ownership of the deployment. Never forward it."
      },
      "health": {
        "state": "unknown",
        "checkedAt": null,
        "failures": 0
      },
      "verification": {
        "status": "live-tested",
        "resourcesByteExact": true,
        "verifiedAt": "2026-09-10",
        "note": "live-tested: JS/CSS/font resources are served byte-identical. ShipStatic rewrites served HTML by appending a ?_ship=<id> cache-busting query to asset URLs, so HTML bytes differ and are not hash-verified. Its multipart parser also silently drops zero-byte file parts, so an artifact containing one is rejected as a capability failure before upload."
      }
    },
