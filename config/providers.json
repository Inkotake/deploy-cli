    {
      "id": "here-now",
      "label": "here.now",
      "adapter": "here-now",
      "endpoint": "https://here.now/api/v1/publish",
      "protocol": "presigned-multistep",
      "protocolNotes": "Live-verified 3-step flow: 1) POST /api/v1/publish with {files:[{path,size,contentType}]} and read upload.uploads[], upload.versionId, upload.finalizeUrl, siteUrl, publishStatus.expiresAt, claimToken, claimUrl. 2) PUT each file to the presigned *.r2.cloudflarestorage.com URL using exactly the returned headers. 3) POST upload.finalizeUrl with {versionId}; a null versionId is rejected with 400 invalid_type, so finalize is never called without one. Finalize is idempotent by versionId; concurrent finalize returns 409 finalize_in_flight with Retry-After.",
      "transport": "multistep",
      "allowedHosts": [
        "here.now",
        "*.here.now",
        "*.r2.cloudflarestorage.com"
      ],
      "modes": [
        "quick-share"
