        "maxTotalBytes": null,
        "maxTotalBytesSource": null,
        "supportedExtensions": null,
        "denyExtensions": [],
        "extensionPolicy": "any",
        "supportsModelFiles": true,
        "claimable": true,
        "htmlExact": false,
        "ttl": {
          "defaultSeconds": 86400,
          "optionsSeconds": null,
          "source": "24 hours anonymous lifetime"
